# credentials: never commit
kaggle.json

# competition data (large, licensed); the frozen split definitions are kept
data/*
!data/splits/

# external material: never versioned
data/external/
outputs/external/
outputs/magnetograms/

# network weights and heavy derived artefacts. Exception: the 17 checkpoints of the submitted
# system are tracked (added with `git add -f`; README, "Network weights"); a tracked file is not
# affected by these patterns. Everything else under these paths stays out.
*.pt
*.pth
*.onnx
*.npz
*.fits
*.zip
*.tar
*.cache
outputs/runs/
outputs/runs_aug/
outputs/oof_cache/
outputs/semantic/
outputs/submissions/*_reproduced.csv

# build products
report/overleaf/build/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
report/*_preview.pdf
